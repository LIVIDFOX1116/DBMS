# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit real API keys or DB passwords.

# Get a free key at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Ethereum mainnet. See https://docs.etherscan.io/supported-chains for others.
CHAIN_ID=1

# Case study (Phase 0.5 -- see ingestion/config.py for the rationale).
# Default is the Poly Network attacker address; override to change it.
CASE_STUDY_ADDRESS=0xC8a65Fadf0e0dDAf421F28FEAb69Bf6E2E589963
HOP_COUNT=2
MAX_TX_PER_ADDRESS=500
REQUESTS_PER_SECOND=4

# Postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=framecheck
PGUSER=postgres
PGPASSWORD=

# api/main.py: "mock" (default, no DB needed) or "live"
FRAMECHECK_API_MODE=mock

# graph/backend.py: set to 1 to force the CPU path even if RAPIDS is installed
FRAMECHECK_FORCE_CPU=0

# --- Google sign-in (Phase 5) -------------------------------------------
# Create an OAuth 2.0 client at https://console.cloud.google.com/apis/credentials
#   - "Desktop app" for the Tauri shell (loopback redirect, no secret used)
#   - "Web application" for the browser dashboard, redirect URI
#     http://localhost:8000/auth/callback
# PLACEHOLDERS ONLY -- put real values in .env, which is gitignored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs this backend's own session tokens. Generate a fresh one per install:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every existing session, which is the intended
# way to sign everyone out.
FRAMECHECK_SESSION_SECRET=

# api/auth.py: "required" (default -- fails closed) or "disabled" for local
# development without a Google client. Never set this to "disabled" on a
# machine others can reach.
FRAMECHECK_AUTH_MODE=required
