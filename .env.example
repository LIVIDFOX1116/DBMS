# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit real API keys or DB passwords.

# Get a free key at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Ethereum mainnet. See https://docs.etherscan.io/supported-chains for others.
CHAIN_ID=1

# Case study (Phase 0.5 -- see ingestion/config.py for the rationale).
# Default is the Poly Network attacker address; override to change it.
CASE_STUDY_ADDRESS=0xC8a65Fadf0e0dDAf421F28FEAb69Bf6E2E589963
HOP_COUNT=2
MAX_TX_PER_ADDRESS=500
REQUESTS_PER_SECOND=4

# Postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=framecheck
PGUSER=postgres
PGPASSWORD=

# api/main.py: "mock" (default, no DB needed) or "live"
FRAMECHECK_API_MODE=mock

# graph/backend.py: set to 1 to force the CPU path even if RAPIDS is installed
FRAMECHECK_FORCE_CPU=0
