.env
# ... and any backup of it: these carry the same secrets (PGPASSWORD, the
# Etherscan key, the Google client secret) and a stray `.env.bak` is the
# easiest way to commit all three at once.
.env.*
__pycache__/
*.pyc
.pytest_cache/
node_modules/
snapshots/*.parquet
.state/
*.egg-info/
.venv/
venv/
.venv-win/
/build/
.ipynb_checkpoints/
.claude/

# Database dumps taken before migrations/data changes -- local safety copies,
# often hundreds of MB, and they contain real ingested data. Never committed.
backups/
