// FrameCheck -- complete schema, all 26 tables (v3).
//
// Generated BY HAND from the DDL, which stays the single source of truth:
//   db/schema.sql  ->  db/migrations/002..009 (filename order)  ->  api/dbsetup.py (schema_migration)
// tests/test_er_coverage.py fails if a table, column or foreign key in that DDL is missing here.
//
// Rendered outputs (never edit them directly -- regenerate):
//   scripts/render_er.ps1  (or render_er.sh)
//     -> docs/ER_Diagram_TransactionGraphAnalyzer.svg / .png   (@softwaretechnik/dbml-renderer)
//     -> docs/DATA_DICTIONARY.md                              (scripts/gen_data_dictionary.py)
// Also pastes straight into https://dbdiagram.io.
//
// Conventions: every FK is an inline `ref:` (> many-to-one, - one-to-one).
// Tables with NO foreign key by design say why in their Note -- none were
// added to the database to make this picture look more connected.

Project framecheck {
  database_type: 'PostgreSQL'
  Note: '''26 tables, 35 foreign keys. DDL in SQL (db/schema.sql + db/migrations), data access through the SQLAlchemy ORM (db/orm/).
Not drawn as a table: the materialized view mv_cluster_flag_stats (migration 008), a precomputed cluster x flag join that /clusters/top-flagged reads.'''
}

// ===========================================================================
// Ingestion: on-chain data pulled from Etherscan (db/schema.sql)
// ===========================================================================

Table wallet [headercolor: #2f6fed] {
  wallet_id bigint [pk, increment]
  address char(42) [unique, not null]
  address_type varchar(10) [not null, default: 'EOA', note: "CHECK (address_type IN ('EOA', 'CONTRACT'))"]
  first_seen_block bigint
  last_seen_block bigint
  balance_wei numeric(38,0) [default: 0]
  total_sent_wei numeric(38,0) [default: 0]
  total_recv_wei numeric(38,0) [default: 0]
  tx_count int [default: 0, note: 'Index idx_wallet_tx_count (tx_count DESC NULLS LAST), migration 007']
  risk_score decimal(5,2)

  Note: 'Graph vertex: one row per Ethereum address. The hub nearly every other table references. (db/schema.sql)'
}

Table block [headercolor: #2f6fed] {
  block_number bigint [pk]
  block_hash char(66) [unique, not null]
  proposer_wallet_id bigint [ref: > wallet.wallet_id, note: 'Proof-of-stake proposer (replaces the legacy "miner" naming)']
  block_timestamp timestamp [not null]
  gas_used bigint
  gas_limit bigint
  tx_count int

  Note: 'One row per Ethereum block a crawled transaction sits in. (db/schema.sql)'
}

Table transaction [headercolor: #2f6fed] {
  tx_hash char(66) [pk]
  block_number bigint [not null, ref: > block.block_number]
  from_wallet_id bigint [not null, ref: > wallet.wallet_id, note: 'The SIGNER -- the only trustworthy "who sent this"']
  to_wallet_id bigint [ref: > wallet.wallet_id, note: 'Nullable: contract-creation transactions have no recipient']
  value_wei numeric(38,0) [not null, note: 'CHECK transaction_value_wei_nonneg (value_wei >= 0), migration 007']
  gas_price bigint
  gas_used bigint
  tx_index smallint
  nonce int
  status boolean
  method_id char(10)
  is_simulated boolean [default: false, note: 'Migration 002: true only for synthetic transfers from scripts/simulate_framing.py -- never a real transaction']

  Note: '''Graph edge: a signed external transaction (associative entity resolving wallet-to-wallet m:n). (db/schema.sql)
Indexes: idx_tx_from, idx_tx_to, idx_tx_block (schema.sql); idx_tx_to_block (to_wallet_id, block_number), idx_tx_from_block (from_wallet_id, block_number) and BRIN idx_tx_block_brin (block_number) (migration 002).'''
}

Table token [headercolor: #2f6fed] {
  token_id int [pk, increment]
  contract_wallet_id bigint [unique, not null, ref: - wallet.wallet_id, note: 'One-to-one subtype link: the token contract IS a wallet row']
  contract_address char(42) [unique, not null]
  symbol varchar(128) [note: 'Attacker-controlled (any contract sets its own symbol), hence the width']
  token_name varchar(255)
  decimals smallint
  standard varchar(10) [default: 'ERC20']

  Note: 'One row per ERC-20 contract seen in a token transfer. (db/schema.sql)'
}

Table token_transfer [headercolor: #2f6fed] {
  transfer_id bigint [pk, increment]
  tx_hash char(66) [not null, ref: > transaction.tx_hash]
  token_id int [not null, ref: > token.token_id]
  from_wallet_id bigint [not null, ref: > wallet.wallet_id, note: 'From the Transfer event log -- forgeable; the real signer is transaction.from_wallet_id via tx_hash']
  to_wallet_id bigint [not null, ref: > wallet.wallet_id]
  token_amount numeric(78,0) [note: 'Raw uint256. CHECK token_transfer_amount_nonneg (token_amount >= 0), migration 007']
  log_index smallint

  indexes {
    (tx_hash, log_index) [unique]
    from_wallet_id [name: 'idx_tt_from']
    to_wallet_id [name: 'idx_tt_to']
  }

  Note: 'One row per ERC-20 Transfer event inside a transaction. (db/schema.sql)'
}

Table label [headercolor: #2f6fed] {
  label_id int [pk, increment]
  label_name varchar(60) [unique, not null]
  category varchar(30)
  source varchar(40)
  is_sanctioned boolean [default: false]

  Note: 'A named tag that can be attached to wallets (exchange, sanctioned, mixer...). (db/schema.sql)'
}

Table wallet_label [headercolor: #2f6fed] {
  wallet_id bigint [not null, ref: > wallet.wallet_id]
  label_id int [not null, ref: > label.label_id]
  tagged_by int [ref: > analyst.analyst_id]
  confidence decimal(4,3)
  tagged_at timestamp [default: `now()`]

  indexes {
    (wallet_id, label_id) [pk]
  }

  Note: 'Associative entity: which labels apply to which wallet, and who applied them. (db/schema.sql)'
}

// ===========================================================================
// Snapshot and analysis: graph snapshots and GPU/CPU algorithm runs
// ===========================================================================

Table graph_snapshot [headercolor: #1f9d55] {
  snapshot_id int [pk, increment]
  snapshot_name varchar(80) [unique, not null]
  file_path varchar(255) [not null, note: 'Parquet edge list, stored relative to the repo / FRAMECHECK_DATA_DIR']
  file_format varchar(10) [not null, default: 'parquet']
  start_block bigint
  end_block bigint
  vertex_count bigint
  edge_count bigint
  is_directed boolean [default: true]
  checksum_sha256 char(64)
  created_at timestamp [default: `now()`]

  Note: 'A frozen, block-bounded edge list that every analysis run reads. (db/schema.sql)'
}

Table snapshot_edge [headercolor: #1f9d55] {
  edge_id bigint [pk, increment]
  snapshot_id int [not null, ref: > graph_snapshot.snapshot_id]
  src_wallet_id bigint [not null, ref: > wallet.wallet_id]
  dst_wallet_id bigint [not null, ref: > wallet.wallet_id]
  edge_weight double [note: 'Summed wei as DOUBLE PRECISION; rounding beyond ~15 digits is documented in migration 007']
  transfer_count int [default: 1]

  indexes {
    (snapshot_id, src_wallet_id, dst_wallet_id) [unique]
    src_wallet_id [name: 'idx_se_src']
    dst_wallet_id [name: 'idx_se_dst']
  }

  Note: 'One aggregated wallet-to-wallet edge per snapshot (the CSR edge the graph algorithms consume). (db/schema.sql)'
}

Table snapshot_edge_tx [headercolor: #1f9d55] {
  snapshot_edge_id bigint [not null, ref: > snapshot_edge.edge_id]
  tx_hash char(66) [not null, ref: > transaction.tx_hash]

  indexes {
    (snapshot_edge_id, tx_hash) [pk]
  }

  Note: 'Bridge entity: traces one aggregated edge back to every transaction that fed it. (db/schema.sql)'
}

Table algorithm [headercolor: #1f9d55] {
  algorithm_id int [pk, increment]
  algorithm_name varchar(40) [unique, not null]
  category varchar(20) [not null, note: 'centrality / community / traversal / detector']
  cugraph_function varchar(60)
  default_params jsonb
  library_version varchar(20)

  Note: 'Catalogue of runnable algorithms and detectors; seeded by schema.sql and migrations 003-004.'
}

Table analysis_run [headercolor: #1f9d55] {
  run_id bigint [pk, increment]
  snapshot_id int [not null, ref: > graph_snapshot.snapshot_id]
  algorithm_id int [not null, ref: > algorithm.algorithm_id]
  analyst_id int [not null, ref: > analyst.analyst_id]
  parameters jsonb
  gpu_device varchar(40) [note: 'Backend name, e.g. "cudf+cugraph (GPU)" or "pandas+networkx (CPU)"']
  gpu_memory_mb int
  started_at timestamp
  completed_at timestamp
  runtime_ms int
  status varchar(12) [default: 'PENDING']
  backend_library_version varchar(40) [note: 'Added by ALTER TABLE in schema.sql (2026-09 migration)']

  Note: 'One execution of one algorithm on one snapshot. Every result row below points back here. (db/schema.sql)'
}

Table vertex_metric [headercolor: #1f9d55] {
  metric_id bigint [pk, increment]
  run_id bigint [not null, ref: > analysis_run.run_id]
  wallet_id bigint [not null, ref: > wallet.wallet_id]
  metric_name varchar(30) [not null]
  metric_value double
  rank_position int

  indexes {
    (run_id, wallet_id, metric_name) [unique]
    run_id [name: 'idx_vm_run']
  }

  Note: 'Per-wallet algorithm output (PageRank score, BFS distance...). (db/schema.sql)'
}

Table cluster [headercolor: #1f9d55] {
  cluster_id bigint [pk, increment]
  run_id bigint [not null, ref: > analysis_run.run_id, note: 'Index idx_cluster_run_id (run_id DESC), migration 007']
  community_label int [not null]
  member_count int
  internal_edges bigint
  modularity_score double
  cluster_type varchar(20) [note: 'SYBIL / WASH_TRADE / MIXER / PEEL_CHAIN']
  risk_score decimal(5,2)

  Note: 'One Louvain community from one run. (db/schema.sql)'
}

Table cluster_member [headercolor: #1f9d55] {
  cluster_id bigint [not null, ref: > cluster.cluster_id]
  wallet_id bigint [not null, ref: > wallet.wallet_id, note: 'Index idx_cluster_member_wallet, migration 007']
  membership_score double
  is_core_node boolean [default: false]
  in_degree int
  out_degree int

  indexes {
    (cluster_id, wallet_id) [pk]
  }

  Note: 'Associative entity: which wallets belong to which cluster. (db/schema.sql)'
}

Table alert [headercolor: #1f9d55] {
  alert_id bigint [pk, increment]
  run_id bigint [not null, ref: > analysis_run.run_id]
  cluster_id bigint [ref: > cluster.cluster_id]
  wallet_id bigint [ref: > wallet.wallet_id]
  reviewed_by int [ref: > analyst.analyst_id]
  pattern_type varchar(20) [not null]
  severity varchar(10) [not null]
  confidence decimal(4,3)
  detected_at timestamp [default: `now()`]
  review_status varchar(12) [default: 'NEW']

  Note: 'A suspicious cluster or wallet raised for analyst review. (db/schema.sql)'
}

Table visualization [headercolor: #1f9d55] {
  viz_id int [pk, increment]
  run_id bigint [not null, ref: > analysis_run.run_id]
  layout_algorithm varchar(40)
  image_path varchar(255)
  image_format varchar(10)
  nodes_rendered int
  edges_rendered int
  generated_at timestamp [default: `now()`]

  Note: 'A rendered graph image produced from a run. (db/schema.sql)'
}

Table analyst [headercolor: #1f9d55] {
  analyst_id int [pk, increment]
  username varchar(40) [unique, not null]
  email varchar(120) [not null]
  password_hash char(60) [not null]
  role varchar(20) [not null, default: 'analyst']
  organisation varchar(80)
  created_at timestamp [not null, default: `now()`]

  Note: 'Who ran or reviewed an analysis. A seeded "system" row backs every pipeline run; distinct from app_user (sign-in). (db/schema.sql)'
}

// ===========================================================================
// FrameCheck audit: flags, their evidence, and the tamper-evident audit trail
// ===========================================================================

Table framing_scenario [headercolor: #d9781c] {
  scenario_id bigint [pk, increment]
  attacker_wallet_ids "bigint[]" [not null]
  target_wallet_ids "bigint[]" [not null]
  transfer_count int [not null]
  total_value_wei numeric(38,0) [not null]
  created_at timestamp [not null, default: `now()`]

  Note: '''One run of scripts/simulate_framing.py (simulation only, reversible with --cleanup). (migration 002)
No FK by design: the attacker and target wallet ids are BIGINT[] arrays, which PostgreSQL cannot constrain with a foreign key.'''
}

Table flag [headercolor: #d9781c] {
  flag_id bigint [pk, increment]
  run_id bigint [not null, ref: > analysis_run.run_id, note: 'Index idx_flag_run']
  wallet_id bigint [not null, ref: > wallet.wallet_id, note: 'Index idx_flag_wallet']
  detector varchar(30) [not null, note: 'bfs_proximity / sybil_cluster / pagerank_threshold / impurity / engaged_proximity']
  score double
  threshold double
  created_at timestamp [not null, default: `now()`]
  token_contract char(42) [note: 'Migration 005: the ERC-20 contract that crossed the threshold; NULL for native ETH']

  Note: '''One detector-raised signal that the audit engine interrogates for frameability. (migration 002)
System-versioned (migration 009): trigger flag_versioning (AFTER UPDATE OR DELETE) writes every before-image into flag_history; flag_as_of(ts) and flag_versions(id) read it back.'''
}

Table flag_evidence [headercolor: #d9781c] {
  flag_id bigint [not null, ref: > flag.flag_id, note: 'Index idx_flag_evidence_flag']
  tx_hash char(66) [not null, ref: > transaction.tx_hash]
  hop int [not null]
  block_number bigint [not null]
  role varchar(12) [not null, note: "CHECK (role IN ('signed', 'unsolicited')); set from transaction.from_wallet_id, never token_transfer.from_wallet_id"]

  indexes {
    (flag_id, tx_hash) [pk]
  }

  Note: 'The transactions a flag rests on, time-ordered by block. (migration 002)'
}

Table flag_audit [headercolor: #d9781c] {
  flag_audit_id bigint [pk, increment]
  flag_id bigint [not null, ref: > flag.flag_id, note: 'Not unique: a flag can be re-audited; the API reports the latest. Index idx_flag_audit_flag']
  verdict varchar(12) [not null, note: "CHECK (verdict IN ('frameable', 'robust'))"]
  framing_cost_wei numeric(38,0) [note: 'CHECK flag_audit_cost_nonneg (NULL or >= 0), migration 007']
  framing_gas bigint [note: 'CHECK flag_audit_gas_nonneg (NULL or >= 0), migration 007']
  minimal_tx_set jsonb
  method varchar(20) [not null, note: "CHECK (method IN ('exact', 'greedy_upper_bound', 'yes_no')); greedy is an upper bound, only exact is a true minimum"]
  backend varchar(40)
  runtime_ms int
  created_at timestamp [not null, default: `now()`]
  prev_hash bytea [note: 'Migration 009: row_hash of the preceding audit row (genesis links to a fixed seed). Set by trigger, never by the app']
  row_hash bytea [note: 'Migration 009: sha256(prev_hash || flag_audit_payload(row)). Set by trigger, never by the app']

  Note: '''One audit verdict: could an outsider have manufactured this flag, and at what cost. (migration 002)
Append-only and hash-chained (migration 009): trigger flag_audit_chain (BEFORE INSERT) links each row to the last; trigger flag_audit_append_only refuses UPDATE, and refuses DELETE unless framecheck.allow_audit_delete = on, tombstoning it. flag_audit_chain_verify() names the first row that does not fit.'''
}

Table flag_history [headercolor: #d9781c] {
  flag_history_id bigint [pk, increment]
  flag_id bigint [not null, note: 'Deliberately NOT a foreign key: history must outlive the flag row it describes']
  change_op char(1) [not null, note: "CHECK (change_op IN ('U', 'D'))"]
  changed_by text [not null]
  before_image jsonb [not null, note: 'to_jsonb(OLD): generic, so later columns are captured without changing this table']
  sys_period tstzrange [not null, note: 'CHECK (NOT isempty(sys_period)); [became current, stopped being)']

  indexes {
    (flag_id, sys_period) [name: 'idx_flag_history_flag']
  }

  Note: '''Before-images of every changed or deleted flag, with the period each version was valid for. Written only by trigger flag_versioning. (migration 009)
No FK by design: history must outlive the flag it describes -- scripts/run_experiment.py deletes flags wholesale, and a FK would block that or cascade the history away.
Non-overlap: EXCLUDE USING gist (flag_id WITH =, sys_period WITH &&) as flag_history_no_overlap when btree_gist is available, else a unique index on (flag_id, lower(sys_period)).'''
}

Table flag_audit_tombstone [headercolor: #d9781c] {
  tombstone_id bigint [pk, increment]
  flag_audit_id bigint [not null, note: 'Logical reference to the deleted flag_audit row -- no FK, because that row is gone. Index idx_flag_audit_tombstone_audit']
  flag_id bigint [not null]
  verdict varchar(12)
  row_hash bytea [note: 'What the chain expected to find at this position']
  deleted_by text [not null]
  deleted_at timestamptz [not null, default: `now()`]
  reason text [not null]

  Note: '''Every audit row ever deleted, who deleted it and why. A chain gap with no tombstone is tampering; a gap with one is housekeeping. Written only by trigger flag_audit_append_only. (migration 009)
No FK by design: it names flag_audit rows that have been deleted, so there is nothing left to reference.'''
}

// ===========================================================================
// App and ops: sign-in and schema bookkeeping
// ===========================================================================

Table app_user [headercolor: #64748b] {
  user_id bigint [pk, increment]
  google_sub text [unique, not null, note: 'Google subject id: stable, unlike the email address']
  email text [not null, note: 'Index idx_app_user_email']
  display_name text
  picture_url text
  created_at timestamptz [not null, default: `now()`]
  last_login_at timestamptz

  Note: '''A person who signed in with Google. (migration 006)
No FK by design: "Nothing in the analysis schema references this table: the audit trail is about wallets, not operators, and FrameCheck must keep working with auth disabled."'''
}

Table schema_migration [headercolor: #64748b] {
  filename varchar(200) [pk]
  applied_at timestamp [not null, default: `now()`]

  Note: '''Which migration files have been applied to this database. Created by api/dbsetup.py, not by a migration.
No FK by design: bookkeeping about the schema itself, not data in it.'''
}

// ===========================================================================
// Groups (drawn as clusters)
// ===========================================================================

TableGroup ingestion {
  wallet
  block
  transaction
  token
  token_transfer
  label
  wallet_label
}

TableGroup snapshot_and_analysis {
  graph_snapshot
  snapshot_edge
  snapshot_edge_tx
  algorithm
  analysis_run
  vertex_metric
  cluster
  cluster_member
  alert
  visualization
  analyst
}

TableGroup framecheck_audit {
  framing_scenario
  flag
  flag_evidence
  flag_audit
  flag_history
  flag_audit_tombstone
}

TableGroup app_and_ops {
  app_user
  schema_migration
}
